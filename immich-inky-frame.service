[Unit]
Description=Immich random photo server for Inky Frame
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
ExecStart=__APP_DIR__/immich-inky-frame
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
